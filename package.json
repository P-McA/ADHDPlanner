{
  "name": "adhd-planner",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@adhd/api",
    "dev:web": "turbo run dev --filter=@adhd/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}\"",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@adhd/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~6.0.2"
  }
}
