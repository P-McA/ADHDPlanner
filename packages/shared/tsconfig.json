{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Editor + lint view: covers tests and config files, never emits.",
  "extends": "@adhd/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
