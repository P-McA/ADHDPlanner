# Copy to .env for local development. Values match docker-compose.yml.
# Postgres is on host port 5434 (see the note in docker-compose.yml).
DATABASE_URL="postgresql://adhd:adhd_local_dev@localhost:5434/adhd?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Clerk (https://dashboard.clerk.com → API keys). The API boots without these,
# but every guarded route (GET /me, /tasks/*) returns 401 until they are set:
# clerkMiddleware() cannot verify a session without the secret key.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Browser origins allowed to call this API with credentials. Unset outside
# production means http://localhost:3000 (the Next.js dev server) and nothing
# else; a wildcard is not an option here because the client sends credentials.
CORS_ORIGINS="http://localhost:3000"

# Development sign-in bypass. With this set to true — and only when NODE_ENV is
# not production — an `x-dev-user: <label>` header signs the request in as a
# local user provisioned on the spot (dev_<label>), without ever calling Clerk.
# It exists so apps/web is usable with no Clerk tenant. Leave it unset unless
# you are that developer: it is a full authentication bypass, which is why it
# is a server-side flag. The web app's NEXT_PUBLIC_DEV_MODE only decides
# whether the browser *sends* the header — being bundle-inlined, it could never
# be the thing that protects a route.
DEV_AUTH_BYPASS=false

# Object storage for voice memos. MinIO locally (docker compose up -d minio),
# S3 or R2 when deployed — the API only speaks the S3 API, so switching is an
# endpoint and a credential, not a code change.
#
# The bucket is private and stays that way: no public-read policy is ever set,
# and reads go through the API, which knows who is asking. The API creates it
# at boot if it is missing (see StorageService.ensureBucket for why that is
# done in the app rather than an mc init container), and carries on without it
# if the credentials may not create buckets — /health then reports the truth.
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_REGION="us-east-1"
MINIO_BUCKET="voice-memos"
MINIO_ACCESS_KEY="adhd"
MINIO_SECRET_KEY="adhd_local_dev"
