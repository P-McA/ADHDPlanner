# Copy to .env for local development. Values match docker-compose.yml.
# Postgres is on host port 5434 (see the note in docker-compose.yml).
DATABASE_URL="postgresql://adhd:adhd_local_dev@localhost:5434/adhd?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Clerk (https://dashboard.clerk.com → API keys). The API boots without these,
# but every guarded route (GET /me, /tasks/*) returns 401 until they are set:
# clerkMiddleware() cannot verify a session without the secret key.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
