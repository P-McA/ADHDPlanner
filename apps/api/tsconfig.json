{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Editor + lint view: covers specs and config files, never emits.",
  "extends": "@adhd/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "prisma.config.ts"
  ]
}
