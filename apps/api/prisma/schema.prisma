// Phase 1 schema: users and tasks only.
//
// Scope note: docs/adhd_tracker.md §3 describes the full target model
// (task_steps, gamification, media_inputs, agents, embeddings). Everything
// beyond users and tasks is Phase 2+ and is deliberately omitted here.
//
// Field selection mirrors the contracts in packages/shared (User, Task,
// TaskStatus, TaskPriority, TaskSource) — those types are the API surface, so
// the columns must line up with them exactly. Columns from the doc that the
// shared contract omits are left out on purpose:
//   users.auth_provider — identity is owned by Clerk, not this table
//   tasks.priority_score / loe_minutes / loe_confidence — AI-derived, Phase 2

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  pending
  in_progress
  done
  archived

  @@map("task_status")
}

enum TaskPriority {
  low
  med
  high
  urgent

  @@map("task_priority")
}

/**
 * Lifecycle of one uploaded media file, from bytes landing in object storage
 * to a draft task existing for the user to confirm.
 *
 * Every transition is a database write, so a worker that dies mid-job leaves
 * the record parked on the stage it died in rather than vanishing. `failed`
 * carries the reason in `error`; `draft_created` is terminal and is the only
 * state in which tasks exist — and those tasks are drafts awaiting the user,
 * never live work.
 */
enum IngestionStatus {
  uploaded
  transcribing
  extracting
  failed
  draft_created

  @@map("ingestion_status")
}

/// Why XP was awarded.
///
/// `badge` is absent on purpose even though starter badges are in this phase:
/// a badge is a thing the user has, not a payment, and it earns its own table
/// when it lands rather than a ledger row that pays zero. `quest` is Phase 2.
/// Adding either later is an additive migration; carrying a value the code
/// cannot produce is dead schema.
///
/// `draft_reviewed` is one value, not an approved/rejected pair, because the
/// direction is already on the task row (`confirmedAt` set, or `archived`) and
/// a single value makes "has this draft been paid for" one condition instead
/// of two.
enum XpEventType {
  task_complete
  streak_bonus
  draft_reviewed

  @@map("xp_event_type")
}

/// Why the API sent a user a notification.
///
/// Mirrors NOTIFICATION_KINDS in @adhd/shared — the enum and the union are the
/// same contract, and the dispatch ledger below is queried by it.
enum NotificationKind {
  due_reminder
  streak_nudge

  @@map("notification_kind")
}

/// What became of one claimed notification.
///
/// `claimed` is written before the send is attempted and is what makes the
/// sweep at-most-once; it is also a real terminal state, meaning the process
/// died between claiming and sending. Left indistinguishable from `sent` that
/// would be invisible.
enum DispatchStatus {
  claimed
  sent
  failed

  @@map("dispatch_status")
}

/// How the task entered the system. Defaults to `manual` so rows created by
/// the plain CRUD path need not state it; the capture pipelines set the rest.
enum TaskSource {
  manual
  voice
  image
  agent
  ai_suggested

  @@map("task_source")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// Clerk's subject id (`user_...`). Identity is owned by Clerk; this column
  /// is the only link back to it. Kept separate from `id` so the internal PK
  /// stays a UUID and `tasks.user_id` needs no retyping.
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  /// IANA zone name, e.g. "Europe/London".
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks    Task[]
  xpEvents XpEvent[]
  ingestionRecords IngestionRecord[]
  streak   Streak?
  pushTokens PushToken[]
  dispatches NotificationDispatch[]

  @@map("users")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(pending)
  manualPriority TaskPriority @default(med) @map("manual_priority")
  source         TaskSource   @default(manual)
  dueAt          DateTime?    @map("due_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  /// When the user accepted an AI suggestion. Null on a draft, and also null
  /// on a hand-typed task, which was authored rather than confirmed. A draft
  /// is the pair: source = ai_suggested AND confirmed_at IS NULL.
  confirmedAt    DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  /// Set on LLM-generated subtasks; null on top-level tasks.
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The voice memo this task was extracted from; null when not from capture.
  /// SetNull rather than Cascade: a draft the user has already accepted is
  /// their task now, and deleting the memo it came from must not delete it.
  ingestionRecordId String?          @map("ingestion_record_id") @db.Uuid
  ingestionRecord   IngestionRecord? @relation(fields: [ingestionRecordId], references: [id], onDelete: SetNull)

  // Self-relation for task decomposition. Cascade rather than SetNull: a
  // subtask is a step *of* its parent, so orphaning it to the top level on
  // delete would leave the list full of steps with no context.
  parent   Task?  @relation("TaskDecomposition", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks Task[] @relation("TaskDecomposition")

  xpEvents XpEvent[]

  // Supports the primary read path: a user's open task list by due date.
  @@index([userId, status, dueAt])
  // Postgres does not index foreign keys automatically; this backs subtask lookup.
  @@index([parentTaskId])
  // Backs "the drafts this memo produced", which is how the pipeline is audited.
  @@index([ingestionRecordId])
  @@map("tasks")
}

/// Append-only XP ledger. There is no balance column anywhere: totals are
/// aggregated from these rows on read, so a total can never disagree with the
/// events that produced it. Nothing in the codebase updates or deletes a row
/// here — only insert and read.
model XpEvent {
  /// BigSerial, not UUID, per docs/adhd_tracker.md: this table only ever grows
  /// and is only ever read in aggregate, so a monotonic integer is both
  /// smaller and better clustered than a random UUID. The id is never
  /// serialised over the wire (JSON cannot represent a BigInt).
  id        BigInt      @id @default(autoincrement())
  userId    String      @map("user_id") @db.Uuid
  /// Null for XP not tied to a specific task, e.g. a streak bonus — and null
  /// again once that task is deleted. The ledger row says "this XP was
  /// legitimately earned at this time", and that outlives the entity it was
  /// earned on: the audit trail is the point of an append-only table.
  ///
  /// It is also the anti-farm rule. If deleting a task refunded its XP, the
  /// reverse would be true — complete, earn, delete, repeat — and undo-by-delete
  /// would become the cheapest XP in the app. The XP stays.
  taskId    String?     @map("task_id") @db.Uuid
  type      XpEventType
  xpAmount  Int         @map("xp_amount")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// What this payment is *for*, where that must be paid at most once —
  /// `task_complete:<taskId>:<user's local date>` for a completion. The unique
  /// index below makes the database refuse a second payment for the same task
  /// on the same day, however many times it is reopened and completed. A task
  /// done again tomorrow is a different key, so a daily habit still pays daily.
  /// Null for event types with no such rule; Postgres treats NULLs as distinct,
  /// so they never collide.
  awardKey  String?     @map("award_key")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Backs the only read path: SUM(xp_amount) for one user.
  @@index([userId])
  @@index([taskId])
  @@unique([userId, awardKey])
  @@map("xp_events")
}

/// One row per user, updated in place. Unlike XP this is genuinely mutable
/// state — a streak is a current fact, not a history — and it is written in
/// the same transaction as the XP insert that caused it.
model Streak {
  /// The user id *is* the key: a user has exactly one streak.
  userId         String    @id @map("user_id") @db.Uuid
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  /// A calendar DATE, not a timestamp, and deliberately so: "did they complete
  /// something yesterday" is a question about the user's local calendar, and
  /// storing an instant would reintroduce the timezone the day was resolved in.
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/**
 * One media upload being turned into task drafts.
 *
 * `objectKey` is the storage key, not a URL: the bucket is private, so there
 * is no durable public address to store, and the endpoint differs per
 * environment (MinIO locally, S3/R2 deployed). Resolving key -> access happens
 * at read time.
 */
model IngestionRecord {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Key within the voice-memos bucket, `{userId}/{uuid}.webm`. */
  objectKey String          @map("object_key")
  status    IngestionStatus @default(uploaded)

  /// What the memo said. Null until transcription succeeds; kept afterwards
  /// even if extraction finds nothing, so "no task in it" stays
  /// distinguishable from "something broke".
  transcript String?

  /** Why it failed, when status is `failed`. Null otherwise. */
  error String?

  /// Drafts extracted from this memo.
  tasks Task[]

  /// When the user erased the memo. Null for a live record.
  ///
  /// A timestamp rather than a `deleted` value on IngestionStatus, because the
  /// status is a pipeline state machine and deletion is orthogonal to it: a
  /// record can be erased whether it reached `draft_created` or `failed`, and
  /// overwriting the status would destroy the very thing that makes a deleted
  /// record worth keeping — the account of what happened to it. Worse, the
  /// processor's terminal-status guard reads exactly those two values, so a
  /// `deleted` status would quietly make an erased record re-processable.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Listing a user's own uploads is the only query shape so far, newest first.
  @@index([userId, createdAt])
  @@map("ingestion_records")
}

/**
 * One device that has asked to receive reminders.
 *
 * Keyed by the Expo token itself, uniquely and globally, rather than by
 * (user, token): a phone that is handed on or signed into by someone else
 * re-registers the same token, and two rows would mean the previous owner
 * keeps receiving the new owner's reminders. Unique means the upsert *moves*
 * the device instead of duplicating it.
 */
model PushToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Expo's opaque device identifier, `ExponentPushToken[...]`.
  token String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Backs the only read path: every device belonging to one user.
  @@index([userId])
  @@map("push_tokens")
}

/**
 * One notification the API has committed to sending — the record that makes a
 * repeated sweep harmless.
 *
 * The row is written *before* the send is attempted, and `@@unique([userId,
 * dedupeKey])` is what refuses the second attempt. That ordering is the whole
 * design: claiming after a successful send would leave a window in which a
 * crash, a retry or an overlapping sweep sends the same reminder twice, and a
 * duplicate notification is the failure users actually notice and punish.
 *
 * The cost is stated plainly: if the provider is down, that reminder is lost
 * for the day rather than retried, because the claim survives the failure. The
 * row carries `failed` and the reason, so it is lost visibly. Trading a missed
 * reminder for a guarantee against duplicates is the right way round for a
 * channel the user cannot mute per-message.
 *
 * `dedupeKey` is a single non-null string rather than a (kind, date, taskId)
 * tuple deliberately: Postgres treats NULLs as distinct in a unique index, so a
 * nullable taskId — which the streak nudge has no value for — would silently
 * permit exactly the duplicates this table exists to prevent.
 */
model NotificationDispatch {
  /// BigSerial like the XP ledger: append-mostly, never addressed from a client.
  id     BigInt @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// Identifies the thing being notified about, within this user. Built by
  /// `dedupeKeyFor` — `due_reminder:2026-09-09:<taskId>`, `streak_nudge:2026-09-09`.
  dedupeKey String @map("dedupe_key")

  /// The user's own calendar date this dispatch was for, resolved in their
  /// timezone. A DATE, like `streaks.last_active_date`, and for the same
  /// reason: "have they already been told today" is a question about their
  /// local calendar, not about a UTC instant.
  localDate DateTime @map("local_date") @db.Date

  status DispatchStatus @default(claimed)

  /// How many devices the notification actually reached. Zero on a failure, and
  /// also zero for a user whose only device was deregistered mid-send.
  deliveredCount Int @default(0) @map("delivered_count")

  /// Why it failed, when status is `failed`. Null otherwise.
  error String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The idempotency guarantee itself. Everything else in this file is
  /// bookkeeping; this line is the property.
  @@unique([userId, dedupeKey])
  // Backs "what did we send this user today", the operator's question.
  @@index([userId, localDate])
  @@map("notification_dispatches")
}
