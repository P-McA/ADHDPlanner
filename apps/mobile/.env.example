# Where the NestJS API lives. Falls back to http://localhost:3001 when unset.
#
# Read this one twice before copying it: on a phone, and on an Android
# emulator, "localhost" is the device itself, not the machine running the API.
# A real device needs your machine's LAN address (http://192.168.x.x:3001) and
# the API reachable on it. The fallback is only useful for an iOS simulator,
# which shares the host's loopback.
EXPO_PUBLIC_API_URL="http://localhost:3001"

# Development sign-in, for working without a Clerk tenant. When this is exactly
# "true" the app attaches `x-dev-user: $EXPO_PUBLIC_DEV_USER` to every API
# call. It grants nothing on its own: the API ignores that header unless it was
# itself started with DEV_AUTH_BYPASS=true outside production. EXPO_PUBLIC_*
# values are inlined into the JavaScript bundle by Metro and are readable by
# anyone holding the app, so this can only ever decide what the client sends,
# never what the server trusts. Same rule as the web client's NEXT_PUBLIC_*.
#
# Leave both unset for the real Clerk path — which the shell does not implement
# yet: `setAuthTokenProvider` in src/lib/api-client.ts is where a Clerk session
# token would be handed in, and until it is, an unset flag means signed out.
EXPO_PUBLIC_DEV_MODE=false
EXPO_PUBLIC_DEV_USER="dev"
