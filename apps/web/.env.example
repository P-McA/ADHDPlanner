# Where the NestJS API lives. Falls back to http://localhost:3001 when unset.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Development sign-in, for working without a Clerk tenant. When this is exactly
# "true" the browser attaches `x-dev-user: $NEXT_PUBLIC_DEV_USER` to every API
# call. It grants nothing on its own: the API ignores that header unless it was
# itself started with DEV_AUTH_BYPASS=true outside production. NEXT_PUBLIC_*
# values are inlined into the client bundle and readable by anyone, so this can
# only ever decide what the browser sends, never what the server trusts.
# Leave both unset for the real Clerk path.
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEV_USER="dev"
